# AlleleIQ configuration
#
# Copy this file to `.env` and adjust values for your environment.
# All settings are loaded via pydantic-settings (see src/alleleiq/config.py)
# and can be overridden with environment variables prefixed ALLELEIQ_.
#
# Example: ALLELEIQ_LOG_LEVEL=DEBUG

# ─────────────────────────────────────────────────────────────
# General
# ─────────────────────────────────────────────────────────────

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
ALLELEIQ_LOG_LEVEL=INFO

# Genome build accepted by the VCF parser. AlleleIQ currently supports
# GRCh38 only; GRCh37 input is rejected with a clear error rather than
# silently misinterpreted (coordinate systems are not interchangeable).
ALLELEIQ_GENOME_BUILD=GRCh38

# ─────────────────────────────────────────────────────────────
# gnomAD v4 GraphQL client
# ─────────────────────────────────────────────────────────────

ALLELEIQ_GNOMAD_API_URL=https://gnomad.broadinstitute.org/api
ALLELEIQ_GNOMAD_DATASET=gnomad_r4
ALLELEIQ_GNOMAD_TIMEOUT_SECONDS=30.0
ALLELEIQ_GNOMAD_MAX_RETRIES=3
# Minimum delay (seconds) enforced between consecutive gnomAD requests,
# out of courtesy to the shared public GraphQL endpoint.
ALLELEIQ_GNOMAD_MIN_REQUEST_INTERVAL_SECONDS=0.5
ALLELEIQ_GNOMAD_CACHE_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────
# Ensembl VEP REST client
# ─────────────────────────────────────────────────────────────

ALLELEIQ_VEP_API_URL=https://rest.ensembl.org
ALLELEIQ_VEP_TIMEOUT_SECONDS=30.0
ALLELEIQ_VEP_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────
# Local REVEL tabix lookup
# ─────────────────────────────────────────────────────────────
# Optional but strongly recommended: VEP's REST-served REVEL coverage is
# incomplete, so without a local index, PP3/BP4 frequently fall back to
# requires_clinical_input for lack of any computational signal. Run
# scripts/download_revel.sh to build this file, then point this setting
# at it. Leave unset to rely on VEP REST's (partial) REVEL coverage only.
ALLELEIQ_REVEL_DATA_PATH=./data/revel_v1.3_all_chromosomes.tsv.gz

# ─────────────────────────────────────────────────────────────
# ClinVar (NCBI E-utilities) client
# ─────────────────────────────────────────────────────────────

ALLELEIQ_CLINVAR_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
ALLELEIQ_CLINVAR_TIMEOUT_SECONDS=30.0
ALLELEIQ_CLINVAR_MAX_RETRIES=3
# Optional NCBI API key. Without a key, NCBI enforces 3 requests/second;
# with a key, 10 requests/second. Obtain one from your NCBI account settings.
ALLELEIQ_CLINVAR_API_KEY=
ALLELEIQ_CLINVAR_REQUESTS_PER_SECOND_NO_KEY=3.0
ALLELEIQ_CLINVAR_REQUESTS_PER_SECOND_WITH_KEY=10.0
# Minimum ClinVar review status star rating considered "strong" evidence.
# Submissions below this rating are surfaced as supporting evidence only.
ALLELEIQ_CLINVAR_MIN_STARS_STRONG_EVIDENCE=2

# ─────────────────────────────────────────────────────────────
# Population coverage thresholds
# ─────────────────────────────────────────────────────────────
# Minimum gnomAD v4 allele number (AN) per ancestry group below which
# frequency data is considered insufficient for confident interpretation.
# These are prototype defaults informed by gnomAD v4 cohort sizes and
# should be revisited as part of the formal validation study.

ALLELEIQ_COVERAGE_THRESHOLD_AFR=10000
ALLELEIQ_COVERAGE_THRESHOLD_AMR=5000
ALLELEIQ_COVERAGE_THRESHOLD_ASJ=3000
ALLELEIQ_COVERAGE_THRESHOLD_EAS=5000
ALLELEIQ_COVERAGE_THRESHOLD_FIN=3000
ALLELEIQ_COVERAGE_THRESHOLD_NFE=20000
ALLELEIQ_COVERAGE_THRESHOLD_SAS=10000
ALLELEIQ_COVERAGE_THRESHOLD_OTH=1000

# A population's allele number below this fraction of its threshold is
# flagged CRITICAL rather than WARNING (see scoring/coverage.py).
ALLELEIQ_COVERAGE_CRITICAL_FRACTION=0.5

# ─────────────────────────────────────────────────────────────
# ACMG/AMP criteria thresholds (ACGS 2024 aligned)
# ─────────────────────────────────────────────────────────────

# BA1: allele frequency above which a variant is presumed benign,
# absent strong conflicting evidence (ACGS 2024 default).
ALLELEIQ_BA1_FREQUENCY_THRESHOLD=0.05

# BS1: allele frequency threshold above expected disease prevalence.
# Disease-specific values should be supplied per analysis; these are
# prototype defaults used when no disease-specific context is given.
ALLELEIQ_BS1_THRESHOLD_DOMINANT=0.01
ALLELEIQ_BS1_THRESHOLD_RECESSIVE=0.03

# PP3/BP4: REVEL score thresholds (ACGS 2024).
ALLELEIQ_REVEL_PP3_SUPPORTING_THRESHOLD=0.70
ALLELEIQ_REVEL_PP3_MODERATE_THRESHOLD=0.90
ALLELEIQ_REVEL_BP4_THRESHOLD=0.15

# PP3/BP4: SpliceAI delta score thresholds.
ALLELEIQ_SPLICEAI_PP3_SUPPORTING_THRESHOLD=0.20
ALLELEIQ_SPLICEAI_PP3_MODERATE_THRESHOLD=0.50
ALLELEIQ_SPLICEAI_BP4_THRESHOLD=0.10

# PVS1: gnomAD constraint thresholds supporting haploinsufficiency.
ALLELEIQ_PLI_HAPLOINSUFFICIENCY_THRESHOLD=0.90
ALLELEIQ_LOEUF_HAPLOINSUFFICIENCY_THRESHOLD=0.35

# ─────────────────────────────────────────────────────────────
# FastAPI / API server
# ─────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for browser clients. For local
# development against a permissive setup, set this to "*" — AlleleIQ then
# automatically disables credentialed CORS (allow_credentials), since
# browsers reject a wildcard origin combined with credentials. Production
# deployments should list explicit origins here instead.
ALLELEIQ_API_CORS_ALLOW_ORIGINS=http://localhost:3000
# In-memory, per-process rate limit. Not shared across workers/replicas —
# see alleleiq/api/middleware.py for this known scope limitation.
ALLELEIQ_API_RATE_LIMIT_PER_HOUR=100
ALLELEIQ_API_MAX_UPLOAD_BYTES=52428800
